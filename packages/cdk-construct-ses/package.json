  "jest": {
    "coverageProvider": "v8",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.ts?(x)",
      "<rootDir>/@(test|src)/**/*(*.)@(spec|test).ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.dev.json"
        }
      ]
    }
  },
  "types": "lib/index.d.ts",
  "stability": "stable",
  "jsii": {
    "outdir": "dist",
    "targets": {
      "java": {
        "package": "com.sevenpico.cdk.construct.ses",
        "maven": {
          "groupId": "com.sevenpico",
          "artifactId": "cdk-construct-ses"
        }
      },
      "python": {
        "distName": "sevenpico.cdk_construct_ses",
        "module": "sevenpico.cdk_construct_ses"
      },
      "dotnet": {
        "namespace": "SevenPico.CdkConstructSes",
        "packageId": "SevenPico.CdkConstructSes"
      },
      "go": {
        "moduleName": "github.com/sevenpico/cdk-constructs",
        "packageName": "cdkconstructses"
      }
    },
    "tsc": {
      "outDir": "lib",
      "rootDir": "src"
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"npx projen\"."
